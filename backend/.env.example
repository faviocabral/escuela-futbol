# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env real.

# Secreto para firmar los tokens JWT de sesión (cualquier string largo y aleatorio)
JWT_SECRET=

# Base de datos PostgreSQL
# En Supabase: Proyecto → Connect → "Direct connection" (o el pooler)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
# Supabase exige SSL: poner true. En Postgres local: false.
DB_SSL=false

# Supabase Storage — opcional en desarrollo
# Proyecto → Settings → API
# Buckets necesarios: 'jugadores-fotos' (público) y 'comprobantes' (privado)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — lectura de comprobantes de transferencia (opcional)
# Sin esta key los pagos se registran igual, pero sin datos extraídos.
GEMINI_API_KEY=

# Puerto del servidor (Render lo inyecta solo)
PORT=3800
NODE_ENV=development
