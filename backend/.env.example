# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env real.

# API key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Token Bearer que exige el backend en cada request (header Authorization)
API_SECRET_TOKEN=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=

# Entorno (development | production)
NODE_ENV=development
